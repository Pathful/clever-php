{
    "name": "pathful/clever-php",
    "description": "Pathful Clever API SDK",
    "homepage": "https://github.com/pathful/clever-php",
    "license": "proprietary",
    "require": {
        "php": "^7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "~3.3",
        "friendsofphp/php-cs-fixer": "~2.2"
    },
    "autoload": {
        "psr-4": { "Clever\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "Clever\\" : "test/" }
    }
}
